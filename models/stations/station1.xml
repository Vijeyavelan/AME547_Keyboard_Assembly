            density="200" friction="0.8 0.005 0.0001" condim="4"/>
      <site name="s1_epdm_grasp" type="sphere" size="0.003"
            pos="-0.06 0 0.00075" rgba="0 0.6 0.8 0.6"/>
    </body>

    <!-- STEP 2: BATTERY — 90x60x6mm LiPo -->
    <!-- body z = 0.805 + 0.003 = 0.808 -->
    <body name="s1_battery" pos="-0.43 0.28 0.828">  <!-- x=-0.25 -->
