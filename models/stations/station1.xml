    </body>

    <!-- STEP 4: SOUND FOAM — 305x107x1mm PE foam -->
    <!-- body z = 0.805 + 0.0005 = 0.8055 -->
    <body name="s1_sound_foam" pos="-1.04 0.28 0.8255">  <!-- x=-0.86 -->
