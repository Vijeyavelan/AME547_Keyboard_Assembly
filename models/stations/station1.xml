            density="200" friction="0.8 0.005 0.0001" condim="4"/>
      <geom name="s1_epdm_rear"  type="box" size="0.1515 0.01225 0.00075"
            pos="0  0.04225 0" material="mat_epdm"
            density="200" friction="0.8 0.005 0.0001" condim="4"/>
      <geom name="s1_epdm_left"  type="box" size="0.06975 0.030 0.00075"
            pos="-0.08975 0 0" material="mat_epdm"
