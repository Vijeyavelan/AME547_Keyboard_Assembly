    <!--
      ═══════════════════════════════════════════════════════════════
      FEEDER CONVEYOR — runs parallel to work table along X axis
      Belt center: x=-0.50, y=0.40, z=0.800 (flush with table top)
      Belt spans x=-1.15 to x=+0.15 (half-length=0.65)
      Belt width: y=0.33 to y=0.47 (half-width=0.075 → 150mm)
      Side rails at y ± 0.082 (32mm above belt face)
      4 support legs at corners

      Parts queue from right (pick end x=0.0) toward left (-X):
        EPDM foam    x= 0.00  (pick here first)
        Battery      x=-0.22
        PCB          x=-0.44
        Sound foam   x=-0.66
        Alu plate    x=-0.88
      Pick point: (0.0, 0.40, 0.805)
      ═══════════════════════════════════════════════════════════════
    -->
    <!-- Feeder center at x=-0.60 so pick end is at x=0.0,
         belt spans x=-1.45 to x=+0.25 (half-length=0.85).
         Rails sit BELOW belt top surface so gripper picks freely.
         Rail top face flush with belt top (z=0.800):
           belt half-z=0.005 → belt top at z=0.805 from body origin=0
           rail half-z=0.010 → rail top at z=0.790 (15mm below belt top)
           rail pos z = 0.790 - 0.010 = 0.780 ... 
           Simpler: belt top=0.805, rail top=0.795 (10mm below belt top)
           rail half-z=0.012, rail center z = 0.800 - 0.012 = 0.788
           So rails are recessed 10mm below belt surface — gripper clears. -->
    <!-- Belt center x=-0.70, spans x=-1.50 to x=+0.10 (half=0.80)
         Pick end at x=0.0, queue extends to x=-1.43 -->
    <body name="s1_feeder" pos="-0.72 0.28 0">
      <!-- Belt surface: 1.6m long, 150mm wide -->
      <geom name="s1_belt" type="box" size="1.070 0.075 0.005"
            pos="0 0 0.820" material="conveyor_belt"
            contype="1" conaffinity="1"/>
      <!-- Front guide rail — recessed 10mm below belt top -->
      <geom name="s1_rail_front" type="box" size="1.070 0.008 0.012"
            pos="0 -0.083 0.803" material="conveyor_rail"
            contype="0" conaffinity="0"/>
      <!-- Rear guide rail -->
      <geom name="s1_rail_rear" type="box" size="1.070 0.008 0.012"
            pos="0  0.083 0.803" material="conveyor_rail"
            contype="0" conaffinity="0"/>
      <!-- End cap right (+X, pick end) -->
      <geom name="s1_cap_r" type="box" size="0.008 0.075 0.012"
            pos="1.078 0 0.803" material="conveyor_rail"
            contype="0" conaffinity="0"/>
      <!-- End cap left (-X, feed end) -->
      <geom name="s1_cap_l" type="box" size="0.008 0.075 0.012"
            pos="-1.078 0 0.803" material="conveyor_rail"
            contype="0" conaffinity="0"/>
      <!-- Structural cross-beam -->
      <geom name="s1_crossbeam" type="box" size="0.820 0.008 0.008"
            pos="0 0 0.783" material="conveyor_rail"
            contype="0" conaffinity="0"/>
      <!-- 4 support legs -->
      <geom name="s1_feed_leg_fl" type="box" size="0.015 0.015 0.408"
            pos="-1.040 -0.060 0.408" material="conveyor_rail"/>
      <geom name="s1_feed_leg_fr" type="box" size="0.015 0.015 0.408"
            pos=" 1.040 -0.060 0.408" material="conveyor_rail"/>
      <geom name="s1_feed_leg_rl" type="box" size="0.015 0.015 0.408"
            pos="-1.040  0.060 0.408" material="conveyor_rail"/>
      <geom name="s1_feed_leg_rr" type="box" size="0.015 0.015 0.408"
            pos=" 1.040  0.060 0.408" material="conveyor_rail"/>
    </body>

    <!--
      ═══════════════════════════════════════════════════════════════
      PARTS ON FEEDER
      All at y=0.40, x spaced 0.22m apart, belt top z=0.805
      Part sits at z = 0.805 + half_height

      Place Z inside case (case floor world z=0.811):
        EPDM foam    z = 0.811 + 0.00375 = 0.81475
        Battery      z = 0.811 + 0.00750 = 0.81850  (x+0.025 offset)
        PCB          z = 0.811 + 0.01130 = 0.82230
        Sound foam   z = 0.811 + 0.01260 = 0.82360
        Alu plate    z = 0.811 + 0.01385 = 0.82485
      ═══════════════════════════════════════════════════════════════
    -->

    <!-- STEP 1: EPDM FOAM — 319x109x1.5mm, 4-geom around battery cutout -->
    <!-- Belt top z=0.805, foam half-height=0.00075, body z=0.80575 -->
    <body name="s1_epdm" pos="0.00 0.28 0.82575">
      <freejoint name="s1_epdm_jnt"/>
      <inertial pos="0 0 0" mass="0.008" diaginertia="1.2e-5 3.8e-5 5.0e-5"/>
