<mujoco model="station2">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Scene: Station 2 (S2) — Pneumatic Screw + Stabilizer Station

    Operations:
      Step 1: 4x pneumatic screwdrivers lower → drive M3 screws → retract  (~12s)
      Step 2: 5x stabilizer press pins lower  → clip stabilizers → retract  (~9s)
    Total cycle: ~21s (parallel to S1)

    Layout:
      - Work table top surface at z=0.800m
      - Assembly pallet top surface at z=0.810m
      - Aluminum plate top surface at z=0.834m (target for all tooling)
      - 4-post gantry straddles table, posts at ±0.420 X, ±0.280 Y
      - Head A (screws)      : retracted at z=1.050m
      - Head B (stabilizers) : retracted at z=1.100m
      - No robot arm

    Coordinate convention:
      +X = keyboard length, +Y = width front-to-back, +Z = up
      All part positions relative to pallet center at (0, 0.030, 0.810)

    Screw boss world positions (from bottom_case.xml):
      FL: (-0.1515,  -0.0195, 0.834)
      FR: (+0.1545,  -0.0195, 0.834)
      RL: (-0.1515,  +0.0795, 0.834)
      RR: (+0.1545,  +0.0795, 0.834)

    Stabilizer world positions (from PCB grid, U=19.05mm):
      Backspace  : (+0.1143, +0.0590, 0.834)
      Left Shift : (-0.1405, +0.0018, 0.834)
      Enter      : (+0.1214, +0.0208, 0.834)
      Right Shift: (+0.1262, +0.0018, 0.834)
      Spacebar   : (+0.0024, -0.0173, 0.834)
  -->

  <compiler angle="radian" autolimits="true"/>
  <option integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4" width="512" height="512"/>
    <material name="floor_mat"      texture="grid" texrepeat="5 5" reflectance="0.2"/>
    <material name="aluminum_plate" rgba="0.75 0.75 0.78 1"/>
    <material name="fixture_stop"   rgba="1.0 0.85 0.0 1"/>
    <material name="abs_plastic"    rgba="0.15 0.15 0.15 1"/>
    <material name="table_surface"  rgba="0.55 0.45 0.35 1"/>
    <material name="table_leg_mat"  rgba="0.4 0.4 0.4 1"/>
    <material name="gantry_mat"     rgba="0.30 0.30 0.32 1"/>
    <material name="gantry_beam"    rgba="0.25 0.25 0.27 1"/>
    <material name="screw_driver"   rgba="0.55 0.55 0.58 1"/>
    <material name="stab_press"     rgba="0.18 0.38 0.55 1"/>
    <material name="pneumatic_hose" rgba="0.7 0.15 0.10 1"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light name="fill_light" pos="1 -1 2" dir="-0.5 0.5 -1"
           directional="true" diffuse="0.3 0.3 0.3"/>
    <light name="gantry_light" pos="0 0.030 1.5" dir="0 0 -1"
           directional="false" diffuse="0.4 0.4 0.4"/>

    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>

    <!-- World frame axis indicator -->
    <body name="axis_indicator" pos="0 0 0">
      <geom name="axis_x" type="cylinder" size="0.0025 0.100"
            pos="0.100 0 0.0025" euler="0 1.5708 0"
            rgba="1 0 0 1" contype="0" conaffinity="0"/>
      <geom name="axis_y" type="cylinder" size="0.0025 0.100"
            pos="0 0.100 0.0025" euler="1.5708 0 0"
            rgba="0 0.8 0 1" contype="0" conaffinity="0"/>
      <geom name="axis_z" type="cylinder" size="0.0025 0.100"
            pos="0 0 0.100"
            rgba="0 0 1 1" contype="0" conaffinity="0"/>
      <geom name="axis_origin" type="sphere" size="0.008"
            pos="0 0 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Work table: top surface at z=0.800m -->
    <body name="work_table" pos="0 0.030 0">
      <geom name="table_top" type="box" size="0.350 0.230 0.010"
            pos="0 0 0.800" material="table_surface"
            contype="1" conaffinity="1"/>
      <geom name="table_leg_fl" type="box" size="0.020 0.020 0.395"
            pos="-0.310 -0.190 0.395" material="table_leg_mat"/>
      <geom name="table_leg_fr" type="box" size="0.020 0.020 0.395"
            pos="0.310 -0.190 0.395"  material="table_leg_mat"/>
      <geom name="table_leg_rl" type="box" size="0.020 0.020 0.395"
            pos="-0.310 0.200 0.395"  material="table_leg_mat"/>
      <geom name="table_leg_rr" type="box" size="0.020 0.020 0.395"
            pos="0.310 0.200 0.395"   material="table_leg_mat"/>
    </body>

    <!-- Assembly pallet: top surface at z=0.810m -->
    <body name="pallet_base" pos="0 0.030 0.810">
      <geom name="base_plate" type="box" size="0.170 0.065 0.004"
            pos="0 0 -0.004" material="aluminum_plate" mass="1.5"/>
      <!-- FL corner -->
      <geom name="stop_FL_x" type="box" size="0.0125 0.0025 0.003"
            pos="-0.1500 -0.0600 0.003" material="fixture_stop" mass="0.02"/>
      <geom name="stop_FL_y" type="box" size="0.0025 0.0125 0.003"
            pos="-0.1650 -0.0475 0.003" material="fixture_stop" mass="0.02"/>
      <!-- FR corner -->
      <geom name="stop_FR_x" type="box" size="0.0125 0.0025 0.003"
            pos="0.1500 -0.0600 0.003" material="fixture_stop" mass="0.02"/>
      <geom name="stop_FR_y" type="box" size="0.0025 0.0125 0.003"
            pos="0.1650 -0.0475 0.003" material="fixture_stop" mass="0.02"/>
      <!-- RL corner -->
      <geom name="stop_RL_x" type="box" size="0.0125 0.0025 0.003"
            pos="-0.1500 0.0600 0.003" material="fixture_stop" mass="0.02"/>
      <geom name="stop_RL_y" type="box" size="0.0025 0.0125 0.003"
            pos="-0.1650 0.0475 0.003" material="fixture_stop" mass="0.02"/>
      <!-- RR corner -->
      <geom name="stop_RR_x" type="box" size="0.0125 0.0025 0.003"
            pos="0.1500 0.0600 0.003" material="fixture_stop" mass="0.02"/>
      <geom name="stop_RR_y" type="box" size="0.0025 0.0125 0.003"
            pos="0.1650 0.0475 0.003" material="fixture_stop" mass="0.02"/>
    </body>

    <!-- Bottom case on pallet -->
    <body name="bottom_case" pos="0 0.030 0.822">
      <geom name="case_bottom" type="box" size="0.1625 0.0575 0.001"
            pos="0 0 -0.011" material="abs_plastic" mass="0.15"/>
      <geom name="case_wall_left"  type="box" size="0.001 0.0575 0.011"
            pos="-0.1615 0 0" material="abs_plastic" mass="0.05"/>
      <geom name="case_wall_right" type="box" size="0.001 0.0575 0.011"
            pos="0.1615 0 0"  material="abs_plastic" mass="0.05"/>
      <geom name="case_wall_front" type="box" size="0.1625 0.001 0.011"
            pos="0 -0.0565 0" material="abs_plastic" mass="0.05"/>
      <geom name="case_wall_rear"  type="box" size="0.1625 0.001 0.011"
            pos="0 0.0565 0"  material="abs_plastic" mass="0.05"/>
    </body>

    <!--
      4-POST GANTRY FRAME
      Posts at X=±0.420, Y=0.030±0.280 (world Y = -0.250 and +0.310)
      Post height: 1200mm, top beam at z=1.200m
      Cross beams connect posts along X at front and rear
      Longitudinal beams connect front-rear along Y at left and right
    -->
    <body name="gantry_frame" pos="0 0 0">

      <!-- 4 vertical posts: 60x60mm cross section, 1200mm tall -->
      <geom name="post_FL" type="box" size="0.030 0.030 0.600"
            pos="-0.420 -0.250 0.600" material="gantry_mat" mass="8.0"/>
      <geom name="post_FR" type="box" size="0.030 0.030 0.600"
            pos="0.420 -0.250 0.600"  material="gantry_mat" mass="8.0"/>
      <geom name="post_RL" type="box" size="0.030 0.030 0.600"
            pos="-0.420 0.310 0.600"  material="gantry_mat" mass="8.0"/>
      <geom name="post_RR" type="box" size="0.030 0.030 0.600"
            pos="0.420 0.310 0.600"   material="gantry_mat" mass="8.0"/>

      <!-- Top frame: 4 beams connecting posts at z=1.200m -->
      <!-- Front cross beam (connects FL-FR) -->
      <geom name="beam_front" type="box" size="0.420 0.025 0.025"
            pos="0 -0.250 1.185" material="gantry_beam" mass="3.0"/>
      <!-- Rear cross beam (connects RL-RR) -->
      <geom name="beam_rear" type="box" size="0.420 0.025 0.025"
            pos="0 0.310 1.185"  material="gantry_beam" mass="3.0"/>
      <!-- Left longitudinal beam (connects FL-RL) -->
      <geom name="beam_left" type="box" size="0.025 0.280 0.025"
            pos="-0.420 0.030 1.185" material="gantry_beam" mass="2.0"/>
      <!-- Right longitudinal beam (connects FR-RR) -->
      <geom name="beam_right" type="box" size="0.025 0.280 0.025"
            pos="0.420 0.030 1.185"  material="gantry_beam" mass="2.0"/>

      <!-- Central carrier beam: spans left-right, carries both head arrays -->
      <geom name="beam_carrier" type="box" size="0.390 0.030 0.020"
            pos="0 0.030 1.150" material="gantry_beam" mass="4.0"/>

      <!--
        HEAD A — SCREW DRIVERS (4 units, gray)
        Retracted position: tips at z=1.050m (150mm above work surface)
        Each driver: 20mm dia cylinder, 80mm long
        Positions match corner boss world XY (pallet at y=+0.030):
          FL: x=-0.1515, y=-0.0195
          FR: x=+0.1545, y=-0.0195
          RL: x=-0.1515, y=+0.0795
          RR: x=+0.1545, y=+0.0795
      -->
      <!-- Screw driver mounting bar -->
      <geom name="screw_bar" type="box" size="0.160 0.015 0.010"
            pos="0 0.030 1.130" material="gantry_beam" mass="1.0"/>

      <!-- Driver FL -->
      <geom name="driver_FL" type="cylinder" size="0.010 0.040"
            pos="-0.1515 -0.0195 1.050" material="screw_driver" mass="0.3"/>
      <geom name="driver_FL_tip" type="cylinder" size="0.004 0.008"
            pos="-0.1515 -0.0195 1.002" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>

      <!-- Driver FR -->
      <geom name="driver_FR" type="cylinder" size="0.010 0.040"
            pos="0.1545 -0.0195 1.050" material="screw_driver" mass="0.3"/>
      <geom name="driver_FR_tip" type="cylinder" size="0.004 0.008"
            pos="0.1545 -0.0195 1.002" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>

      <!-- Driver RL -->
      <geom name="driver_RL" type="cylinder" size="0.010 0.040"
            pos="-0.1515 0.0795 1.050" material="screw_driver" mass="0.3"/>
      <geom name="driver_RL_tip" type="cylinder" size="0.004 0.008"
            pos="-0.1515 0.0795 1.002" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>

      <!-- Driver RR -->
      <geom name="driver_RR" type="cylinder" size="0.010 0.040"
            pos="0.1545 0.0795 1.050" material="screw_driver" mass="0.3"/>
      <geom name="driver_RR_tip" type="cylinder" size="0.004 0.008"
            pos="0.1545 0.0795 1.002" rgba="0.3 0.3 0.3 1"
            contype="0" conaffinity="0"/>

      <!-- Pneumatic hoses to screw drivers (visual only) -->
      <geom name="hose_FL" type="cylinder" size="0.004 0.060"
            pos="-0.1515 -0.0195 1.150" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_FR" type="cylinder" size="0.004 0.060"
            pos="0.1545 -0.0195 1.150" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_RL" type="cylinder" size="0.004 0.060"
            pos="-0.1515 0.0795 1.150" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_RR" type="cylinder" size="0.004 0.060"
            pos="0.1545 0.0795 1.150" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>

      <!--
        HEAD B — STABILIZER PRESS PINS (5 units, blue)
        Retracted position: tips at z=1.060m
        Each pin: 12mm dia cylinder, 60mm long
        Positions (world frame, pallet at y=+0.030):
          Backspace  : x=+0.1143, y=+0.0590
          Left Shift : x=-0.1405, y=+0.0018
          Enter      : x=+0.1214, y=+0.0208
          Right Shift: x=+0.1262, y=+0.0018
          Spacebar   : x=+0.0024, y=-0.0173
      -->
      <!-- Stabilizer mounting bar -->
      <geom name="stab_bar" type="box" size="0.145 0.015 0.008"
            pos="0.0024 0.030 1.128" material="gantry_beam" mass="0.8"/>

      <!-- Pin Backspace -->
      <geom name="pin_backspace" type="cylinder" size="0.006 0.030"
            pos="0.1143 0.0590 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_backspace_tip" type="cylinder" size="0.005 0.005"
            pos="0.1143 0.0590 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pin Left Shift -->
      <geom name="pin_lshift" type="cylinder" size="0.006 0.030"
            pos="-0.1405 0.0018 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_lshift_tip" type="cylinder" size="0.005 0.005"
            pos="-0.1405 0.0018 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pin Enter -->
      <geom name="pin_enter" type="cylinder" size="0.006 0.030"
            pos="0.1214 0.0208 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_enter_tip" type="cylinder" size="0.005 0.005"
            pos="0.1214 0.0208 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pin Right Shift -->
      <geom name="pin_rshift" type="cylinder" size="0.006 0.030"
            pos="0.1262 0.0018 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_rshift_tip" type="cylinder" size="0.005 0.005"
            pos="0.1262 0.0018 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pin Spacebar LEFT (Cherry 6.25U: space_x=-0.0214 - 57.15mm, 14.4mm from LAlt) -->
      <geom name="pin_spacebar_L" type="cylinder" size="0.006 0.030"
            pos="-0.0785 -0.0173 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_spacebar_L_tip" type="cylinder" size="0.005 0.005"
            pos="-0.0785 -0.0173 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pin Spacebar RIGHT (Cherry 6.25U: space_x=-0.0214 + 57.15mm, 11.8mm from RAlt) -->
      <geom name="pin_spacebar_R" type="cylinder" size="0.006 0.030"
            pos="0.0358 -0.0173 1.060" material="stab_press" mass="0.1"/>
      <geom name="pin_spacebar_R_tip" type="cylinder" size="0.005 0.005"
            pos="0.0358 -0.0173 1.025" rgba="0.05 0.20 0.40 1"
            contype="0" conaffinity="0"/>

      <!-- Pneumatic hoses to stabilizer pins -->
      <geom name="hose_bs"  type="cylinder" size="0.003 0.050"
            pos="0.1143 0.0590 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_ls"  type="cylinder" size="0.003 0.050"
            pos="-0.1405 0.0018 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_en"  type="cylinder" size="0.003 0.050"
            pos="0.1214 0.0208 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_rs"  type="cylinder" size="0.003 0.050"
            pos="0.1262 0.0018 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_sp_L" type="cylinder" size="0.003 0.050"
            pos="-0.0785 -0.0173 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>
      <geom name="hose_sp_R" type="cylinder" size="0.003 0.050"
            pos="0.0358 -0.0173 1.140" rgba="0.7 0.15 0.10 1"
            contype="0" conaffinity="0"/>

      <!-- Tool sites: used for controller stroke targets -->
      <site name="screw_FL_target"  pos="-0.1515 -0.0195 0.834" size="0.003" rgba="1 1 0 0.8"/>
      <site name="screw_FR_target"  pos="0.1545  -0.0195 0.834" size="0.003" rgba="1 1 0 0.8"/>
      <site name="screw_RL_target"  pos="-0.1515  0.0795 0.834" size="0.003" rgba="1 1 0 0.8"/>
      <site name="screw_RR_target"  pos="0.1545   0.0795 0.834" size="0.003" rgba="1 1 0 0.8"/>
      <site name="stab_bs_target"   pos="0.1143   0.0590 0.834" size="0.003" rgba="0 0.5 1 0.8"/>
      <site name="stab_ls_target"   pos="-0.1405  0.0018 0.834" size="0.003" rgba="0 0.5 1 0.8"/>
      <site name="stab_en_target"   pos="0.1214   0.0208 0.834" size="0.003" rgba="0 0.5 1 0.8"/>
      <site name="stab_rs_target"   pos="0.1262   0.0018 0.834" size="0.003" rgba="0 0.5 1 0.8"/>
      <site name="stab_sp_L_target"  pos="-0.0785 -0.0173 0.834" size="0.003" rgba="0 0.5 1 0.8"/>
      <site name="stab_sp_R_target"  pos="0.0358  -0.0173 0.834" size="0.003" rgba="0 0.5 1 0.8"/>

    </body>

    <!-- Cameras -->
    <camera name="station2_overview"
            pos="1.2 -1.2 1.8"
            xyaxes="0.8 0.6 0 -0.35 0.47 0.81"/>
    <camera name="gantry_cam"
            pos="0.0 -0.8 1.8"
            xyaxes="1 0 0 0 0.5 0.87"/>
    <camera name="top_down"
            pos="0 0.030 2.0"
            xyaxes="1 0 0 0 1 0"/>

  </worldbody>


</mujoco>