<mujoco model="station3">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Scene: Station 3 (S3) — Switch Insertion Station

    Architecture:
      Central rotating column (hinge joint, Z axis) with 2 heads:
        Head 1 (-Y arm): inserts switch into keyboard socket
        Head 2 (+Y arm): picks switch from tray feeder
      Column rotates 180° after each simultaneous pick+insert cycle
      XY table repositions keyboard to next switch socket during rotation

    Geometry (from column center at x=0, y=0.030):
      Column radius      : 40mm
      Arm length         : 30mm (column edge to head center)
      Head radius        : 10mm
      Total arm reach    : 40 + 30 + 10 = 80mm from column center

      Head 1 (insertion) : y = 0.030 - 0.080 = -0.050m  (toward keyboard)
      Head 2 (pick)      : y = 0.030 + 0.080 = +0.110m  (toward feeder)
      Feeder tray center : y = +0.110m, runs along X axis
      Keyboard rear wall : y = +0.0875m
      Head 2 clearance   : 22.5mm from rear wall ✓

    XY Table:
      Same stack as before, work surface at z=0.800m
      X range: ±160mm, Y range: ±115mm

    Coordinate convention:
      +X = keyboard length, +Y = width front-to-back, +Z = up
  -->

  <compiler angle="radian" autolimits="true"/>
  <option integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.3 0.3 0.3" rgb2="0.4 0.4 0.4" width="512" height="512"/>
    <material name="floor_mat"      texture="grid" texrepeat="5 5" reflectance="0.2"/>
    <material name="aluminum_plate" rgba="0.75 0.75 0.78 1"/>
    <material name="fixture_stop"   rgba="1.0 0.85 0.0 1"/>
    <material name="abs_plastic"    rgba="0.15 0.15 0.15 1"/>
    <material name="table_surface"  rgba="0.55 0.45 0.35 1"/>
    <material name="steel_dark"     rgba="0.25 0.25 0.28 1"/>
    <material name="steel_mid"      rgba="0.40 0.40 0.43 1"/>
    <material name="steel_light"    rgba="0.60 0.60 0.63 1"/>
    <material name="gantry_mat"     rgba="0.30 0.30 0.32 1"/>
    <material name="gantry_beam"    rgba="0.25 0.25 0.27 1"/>
    <material name="column_mat"     rgba="0.35 0.35 0.38 1"/>
    <material name="arm_mat"        rgba="0.50 0.50 0.53 1"/>
    <material name="head_body"      rgba="0.55 0.55 0.58 1"/>
    <material name="head_tip"       rgba="0.15 0.15 0.15 1"/>
    <material name="tray_mat"       rgba="0.70 0.72 0.75 1"/>
    <material name="slide_rail"     rgba="0.50 0.50 0.53 1"/>
    <!-- Switch mesh and materials (from switch_1u.xml) -->
    <material name="abs_dark"
              rgba="0.95 0.95 0.95 1"
              specular="0.3" shininess="0.4" reflectance="0.05"/>
    <material name="abs_dark_collision"
              rgba="0.12 0.12 0.12 0.0"/>
    <mesh name="switch_mesh"
          file="../meshes/Switch_Decimated.stl"
          scale="0.001 0.001 0.001"
          refpos="-7.350 0.053 -7.350"
          refquat="0.7071 -0.7071 0 0"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 0 3"     dir="0 0 -1"      directional="true"/>
    <light name="fill_light" pos="1 -1 2"    dir="-0.5 0.5 -1" directional="true"
           diffuse="0.3 0.3 0.3"/>
    <light name="work_light" pos="0 0.030 1.4" dir="0 0 -1"
           directional="false" diffuse="0.5 0.5 0.5"/>

    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>

    <!-- World frame axis indicator -->
    <body name="axis_indicator" pos="0 0 0">
      <geom name="axis_x" type="cylinder" size="0.0025 0.100"
            pos="0.100 0 0.0025" euler="0 1.5708 0"
            rgba="1 0 0 1" contype="0" conaffinity="0"/>
      <geom name="axis_y" type="cylinder" size="0.0025 0.100"
            pos="0 0.100 0.0025" euler="1.5708 0 0"
            rgba="0 0.8 0 1" contype="0" conaffinity="0"/>
      <geom name="axis_z" type="cylinder" size="0.0025 0.100"
            pos="0 0 0.100"
            rgba="0 0 1 1" contype="0" conaffinity="0"/>
      <geom name="axis_origin" type="sphere" size="0.008"
            pos="0 0 0" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    </body>

    <!--
      XY SLIDING TABLE
      Stack: table_base → y_slide → x_slide → table_top → pallet → case
    -->
    <body name="table_base" pos="0 0.030 0">
      <!-- 4 legs 750mm tall -->
      <geom name="leg_fl" type="box" size="0.020 0.020 0.375"
            pos="-0.230 -0.180 0.375" material="steel_dark" mass="5.0"/>
      <geom name="leg_fr" type="box" size="0.020 0.020 0.375"
            pos="0.230 -0.180 0.375"  material="steel_dark" mass="5.0"/>
      <geom name="leg_rl" type="box" size="0.020 0.020 0.375"
            pos="-0.230 0.180 0.375"  material="steel_dark" mass="5.0"/>
      <geom name="leg_rr" type="box" size="0.020 0.020 0.375"
            pos="0.230 0.180 0.375"   material="steel_dark" mass="5.0"/>
      <!-- Base plate top at z=0.760 -->
      <geom name="base_plate_xy" type="box" size="0.250 0.200 0.010"
            pos="0 0 0.750" material="steel_dark" mass="8.0"
            contype="1" conaffinity="1"/>
      <!-- Y-axis rails -->
      <geom name="rail_y_left"  type="box" size="0.008 0.180 0.008"
            pos="-0.185 0 0.768" material="slide_rail" mass="0.8"/>
      <geom name="rail_y_right" type="box" size="0.008 0.180 0.008"
            pos="0.185 0 0.768"  material="slide_rail" mass="0.8"/>

      <!-- Y SLIDE: 15mm thick, top at z=0.775 -->
      <body name="y_slide" pos="0 0 0.7675">
        <joint name="y_joint" type="slide" axis="0 1 0"
               range="-0.115 0.115" damping="500" stiffness="0"/>
        <geom name="y_slide_plate" type="box" size="0.230 0.170 0.0075"
              pos="0 0 0" material="steel_mid" mass="4.0"/>
        <!-- X-axis rails -->
        <geom name="rail_x_front" type="box" size="0.210 0.006 0.008"
              pos="0 -0.145 0.016" material="slide_rail" mass="0.4"/>
        <geom name="rail_x_rear"  type="box" size="0.210 0.006 0.008"
              pos="0 0.145 0.016"  material="slide_rail" mass="0.4"/>

        <!-- X SLIDE: 15mm thick, top at z=0.790 -->
        <body name="x_slide" pos="0 0 0.020">
          <joint name="x_joint" type="slide" axis="1 0 0"
                 range="-0.160 0.160" damping="500" stiffness="0"/>
          <geom name="x_slide_plate" type="box" size="0.210 0.150 0.0075"
                pos="0 0 0" material="steel_light" mass="3.0"/>

          <!-- TABLE TOP: surface at z=0.800 -->
          <body name="table_top_body" pos="0 0 0.0075">
            <geom name="table_top_surf" type="box" size="0.200 0.140 0.005"
                  pos="0 0 0.005" material="table_surface" mass="2.0"
                  contype="1" conaffinity="1"/>

            <!-- PALLET: top surface at z=0.810 -->
            <body name="pallet_base" pos="0 0 0.010">
              <geom name="base_plate" type="box" size="0.170 0.065 0.004"
                    pos="0 0 0.004" material="aluminum_plate" mass="1.5"/>
              <!-- Corner L-stops -->
              <geom name="stop_FL_x" type="box" size="0.0125 0.0025 0.003"
                    pos="-0.1500 -0.0600 0.010" material="fixture_stop" mass="0.02"/>
              <geom name="stop_FL_y" type="box" size="0.0025 0.0125 0.003"
                    pos="-0.1650 -0.0475 0.010" material="fixture_stop" mass="0.02"/>
              <geom name="stop_FR_x" type="box" size="0.0125 0.0025 0.003"
                    pos="0.1500 -0.0600 0.010"  material="fixture_stop" mass="0.02"/>
              <geom name="stop_FR_y" type="box" size="0.0025 0.0125 0.003"
                    pos="0.1650 -0.0475 0.010"  material="fixture_stop" mass="0.02"/>
              <geom name="stop_RL_x" type="box" size="0.0125 0.0025 0.003"
                    pos="-0.1500 0.0600 0.010"  material="fixture_stop" mass="0.02"/>
              <geom name="stop_RL_y" type="box" size="0.0025 0.0125 0.003"
                    pos="-0.1650 0.0475 0.010"  material="fixture_stop" mass="0.02"/>
              <geom name="stop_RR_x" type="box" size="0.0125 0.0025 0.003"
                    pos="0.1500 0.0600 0.010"   material="fixture_stop" mass="0.02"/>
              <geom name="stop_RR_y" type="box" size="0.0025 0.0125 0.003"
                    pos="0.1650 0.0475 0.010"   material="fixture_stop" mass="0.02"/>

              <!-- BOTTOM CASE -->
              <body name="bottom_case" pos="0 0 0.020">
                <geom name="case_bottom" type="box" size="0.1625 0.0575 0.001"
                      pos="0 0 -0.011" material="abs_plastic" mass="0.15"/>
                <geom name="case_wall_left"  type="box" size="0.001 0.0575 0.011"
                      pos="-0.1615 0 0" material="abs_plastic" mass="0.05"/>
                <geom name="case_wall_right" type="box" size="0.001 0.0575 0.011"
                      pos="0.1615 0 0"  material="abs_plastic" mass="0.05"/>
                <geom name="case_wall_front" type="box" size="0.1625 0.001 0.011"
                      pos="0 -0.0565 0" material="abs_plastic" mass="0.05"/>
                <geom name="case_wall_rear"  type="box" size="0.1625 0.001 0.011"
                      pos="0 0.0565 0"  material="abs_plastic" mass="0.05"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!--
      4-POST GANTRY FRAME (fixed)
      Straddles both table and feeder
      Posts at X=±0.420, front at Y=-0.250, rear at Y=+0.310
    -->
    <body name="gantry_frame" pos="0 0 0">
      <geom name="post_FL" type="box" size="0.030 0.030 0.519"
            pos="-0.420 -0.110 0.519" material="gantry_mat" mass="8.0"/>
      <geom name="post_FR" type="box" size="0.030 0.030 0.519"
            pos="0.420 -0.110 0.519"  material="gantry_mat" mass="8.0"/>
      <geom name="post_RL" type="box" size="0.030 0.030 0.519"
            pos="-0.420 0.450 0.519"  material="gantry_mat" mass="8.0"/>
      <geom name="post_RR" type="box" size="0.030 0.030 0.519"
            pos="0.420 0.450 0.519"   material="gantry_mat" mass="8.0"/>
      <!-- Top frame beams -->
      <geom name="beam_front" type="box" size="0.420 0.025 0.025"
            pos="0 -0.110 1.039" material="gantry_beam" mass="3.0"/>
      <geom name="beam_rear"  type="box" size="0.420 0.025 0.025"
            pos="0 0.450 1.039"  material="gantry_beam" mass="3.0"/>
      <geom name="beam_left"  type="box" size="0.025 0.280 0.025"
            pos="-0.420 0.170 1.039" material="gantry_beam" mass="2.0"/>
      <geom name="beam_right" type="box" size="0.025 0.280 0.025"
            pos="0.420 0.170 1.039"  material="gantry_beam" mass="2.0"/>
      <!-- Central support beam -->
      <geom name="beam_center" type="box" size="0.060 0.025 0.025"
            pos="0 0.170 1.014" material="gantry_beam" mass="1.5"/>
      <!-- Vertical drop shaft from center beam to rotating column -->
      <geom name="drop_shaft" type="cylinder" size="0.015 0.035"
            pos="0 0.170 0.964" material="gantry_mat" mass="0.5"
            contype="0" conaffinity="0"/>
    </body>

    <!--
      ROTATING COLUMN + DUAL ARMS
      Column: large cylinder, rotates around Z axis
      Arm -Y: extends toward keyboard (Head 1 — insertion)
      Arm +Y: extends toward feeder  (Head 2 — pick)

      Column center: x=0, y=0.030, z=1.060
      Arm reach from column center: 80mm (col_r=40 + arm=30 + head_r=10)
      Head 1 tip at: y = 0.030 - 0.080 = -0.050 world Y
      Head 2 tip at: y = 0.030 + 0.080 = +0.110 world Y

      Hinge joint: axis Z, range ±π (full rotation)
      Home pose: 0 rad (Head 1 toward keyboard, Head 2 toward feeder)
    -->
    <body name="rotating_column" pos="0 0.170 0.914">
      <joint name="column_rotation" type="hinge" axis="0 0 1"
             range="-3.1416 3.1416" damping="10" stiffness="0"/>

      <!-- Main column disc: 80mm dia, 40mm tall -->
      <geom name="column_disc" type="cylinder" size="0.040 0.020"
            pos="0 0 0" material="column_mat" mass="3.0"/>

      <!-- === ARM 1: extends in -Y direction toward keyboard === -->
      <!-- Arm 1 bar: 30mm long, connecting column edge to head -->
      <geom name="arm_1" type="box" size="0.012 0.045 0.010"
            pos="0 -0.085 -0.005" material="arm_mat" mass="0.3"/>

      <!-- Head 1 body: 20mm dia cylinder -->
      <geom name="head_1_body" type="cylinder" size="0.010 0.025"
            pos="0 -0.130 -0.005" material="head_body" mass="0.5"/>
      <!-- Head 1 guide rods (spring-loaded visual) -->
      <geom name="rod_1_L" type="cylinder" size="0.003 0.030"
            pos="-0.012 -0.130 -0.010" material="steel_light" mass="0.05"
            contype="0" conaffinity="0"/>
      <geom name="rod_1_R" type="cylinder" size="0.003 0.030"
            pos="0.012 -0.130 -0.010"  material="steel_light" mass="0.05"
            contype="0" conaffinity="0"/>
      <!-- Head 1 gripper tip: 14x14mm switch footprint -->
      <geom name="head_1_tip" type="box" size="0.007 0.007 0.012"
            pos="0 -0.130 -0.042" material="head_tip" mass="0.1"/>
      <!-- Switch in Head 1 (dark — ready to insert) -->
      <geom name="switch_1" type="box" size="0.007 0.007 0.006"
            pos="0 -0.130 -0.060" rgba="0.15 0.15 0.15 1"
            contype="0" conaffinity="0"/>
      <!-- Head 1 pneumatic hose (runs up to column) -->
      <geom name="hose_1" type="cylinder" size="0.003 0.020"
            pos="0.010 -0.085 0.018"
            rgba="0.7 0.15 0.10 1" contype="0" conaffinity="0"/>
      <!-- Head 1 insertion target site -->
      <site name="head_1_tip_site" pos="0 -0.130 -0.066"
            size="0.004" rgba="1 1 0 0.9"/>

      <!-- === ARM 2: extends in +Y direction toward feeder === -->
      <!-- Arm 2 bar -->
      <geom name="arm_2" type="box" size="0.012 0.045 0.010"
            pos="0 0.085 -0.005" material="arm_mat" mass="0.3"/>

      <!-- Head 2 body -->
      <geom name="head_2_body" type="cylinder" size="0.010 0.025"
            pos="0 0.130 -0.005" material="head_body" mass="0.5"/>
      <!-- Head 2 guide rods -->
      <geom name="rod_2_L" type="cylinder" size="0.003 0.030"
            pos="-0.012 0.130 -0.010" material="steel_light" mass="0.05"
            contype="0" conaffinity="0"/>
      <geom name="rod_2_R" type="cylinder" size="0.003 0.030"
            pos="0.012 0.130 -0.010"  material="steel_light" mass="0.05"
            contype="0" conaffinity="0"/>
      <!-- Head 2 gripper tip -->
      <geom name="head_2_tip" type="box" size="0.007 0.007 0.012"
            pos="0 0.130 -0.042" material="head_tip" mass="0.1"/>
      <!-- Switch in Head 2 (yellow — just picked from feeder) -->
      <geom name="switch_2" type="box" size="0.007 0.007 0.006"
            pos="0 0.130 -0.060" rgba="0.9 0.75 0.1 1"
            contype="0" conaffinity="0"/>
      <!-- Head 2 pneumatic hose -->
      <geom name="hose_2" type="cylinder" size="0.003 0.020"
            pos="0.010 0.085 0.018"
            rgba="0.7 0.15 0.10 1" contype="0" conaffinity="0"/>
      <!-- Head 2 pick site -->
      <site name="head_2_tip_site" pos="0 0.130 -0.066"
            size="0.004" rgba="0 1 0 0.9"/>

    </body>

    <!--
      HEAD Z ACTUATORS
      Each head needs independent Z motion (press down to insert/pick)
      In MuJoCo we model these as separate child bodies of rotating_column
      with slide joints along Z.
      NOTE: These bodies inherit the column rotation, so their Z axis
      always points up regardless of rotation angle — correct behavior.
    -->
    <body name="head_1_slide" pos="0 0.170 0.914">
      <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="head_1_z" type="slide" axis="0 0 1"
             range="-0.150 0" damping="200" stiffness="500"/>
    </body>

    <body name="head_2_slide" pos="0 0.170 0.914">
      <inertial pos="0 0 0" mass="0.01" diaginertia="1e-6 1e-6 1e-6"/>
      <joint name="head_2_z" type="slide" axis="0 0 1"
             range="-0.150 0" damping="200" stiffness="500"/>
    </body>

    <!--
      LINEAR TRAY FEEDER — Fixture mounted, world-fixed
      Head 2 tip at world y=0.310 (column y=0.170 + arm 0.140)
      Tray surface at z=0.840m = switch insertion height
      Stand base at y=0.340 (behind pick point, clear of table travel)
      Tray overhangs toward y=0.310 (pick position)
      Table max Y travel: y=0.030+0.140+0.115=0.285m < feeder at 0.310 ✓
    -->
    <body name="tray_feeder" pos="0 0.330 0">

      <!-- Fixture stand: 2 legs supporting the tray at both X ends -->
      <geom name="feeder_leg_FL" type="box" size="0.015 0.015 0.4056"
            pos="-0.285 -0.030 0.4056" material="steel_dark" mass="2.0"
            contype="0" conaffinity="0"/>
      <geom name="feeder_leg_FR" type="box" size="0.015 0.015 0.4056"
            pos="0.010 -0.030 0.4056"  material="steel_dark" mass="2.0"
            contype="0" conaffinity="0"/>
      <!-- Base plate connecting legs -->
      <geom name="feeder_base" type="box" size="0.155 0.040 0.008"
            pos="-0.143 0 0.008" material="steel_dark" mass="2.0"
            contype="0" conaffinity="0"/>
      <!-- Tray support shelf -->
      <geom name="tray_shelf" type="box" size="0.155 0.035 0.005"
            pos="-0.143 -0.025 0.8161" material="steel_mid" mass="1.0"
            contype="0" conaffinity="0"/>

      <!-- Tray body: covers x=0 to x=-0.286, center at x=-0.143, half=0.155 -->
      <geom name="tray_body" type="box" size="0.155 0.015 0.004"
            pos="-0.143 -0.030 0.8221" material="tray_mat" mass="1.5"
            contype="0" conaffinity="0"/>
      <!-- Tray side rails -->
      <geom name="tray_rail_F" type="box" size="0.155 0.002 0.006"
            pos="-0.143 -0.043 0.8291" material="steel_mid" mass="0.2"
            contype="0" conaffinity="0"/>
      <geom name="tray_rail_R" type="box" size="0.155 0.002 0.006"
            pos="-0.143 -0.017 0.8291" material="steel_mid" mass="0.2"
            contype="0" conaffinity="0"/>
      <!-- Back stop rail at +X end (x=0 side) -->
      <geom name="tray_rail_back" type="box" size="0.002 0.015 0.008"
            pos="0.014 -0.030 0.8281" material="steel_mid" mass="0.1"
            contype="0" conaffinity="0"/>



      <!-- Sensor detection site at pick position (x=0, y=0.310 world) -->
      <!-- Pick position site -->
      <site name="pick_position" pos="0 -0.030 0.8261"
            size="0.006" rgba="0 1 0 0.9"/>
    </body>

    <!-- Cameras -->
    <camera name="station3_overview"
            pos="0.8 -0.8 1.6"
            xyaxes="0.7 0.7 0 -0.35 0.35 0.87"/>
    <camera name="head_closeup"
            pos="0.3 -0.3 1.3"
            xyaxes="0.7 0.7 0 -0.4 0.4 0.82"/>
    <camera name="top_down"
            pos="0 0.030 2.0"
            xyaxes="1 0 0 0 1 0"/>
    <camera name="feeder_side"
            pos="0.6 0.4 1.2"
            xyaxes="-0.6 0.8 0 -0.4 -0.3 0.87"/>

    <!--
      TRAY SWITCH POOL — worldbody level (freejoints must be top-level).
      16 real switch bodies, initially placed at tray slot positions.
      Controller slides them via qpos writes each step.
    -->
    <body name="tray_sw_1" pos="0.0000 0.3 0.8261">
      <freejoint name="tray_swj_1"/>
      <geom name="tray_swg_1"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_2" pos="-0.0191 0.3 0.8261">
      <freejoint name="tray_swj_2"/>
      <geom name="tray_swg_2"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_3" pos="-0.0381 0.3 0.8261">
      <freejoint name="tray_swj_3"/>
      <geom name="tray_swg_3"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_4" pos="-0.0572 0.3 0.8261">
      <freejoint name="tray_swj_4"/>
      <geom name="tray_swg_4"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_5" pos="-0.0762 0.3 0.8261">
      <freejoint name="tray_swj_5"/>
      <geom name="tray_swg_5"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_6" pos="-0.0953 0.3 0.8261">
      <freejoint name="tray_swj_6"/>
      <geom name="tray_swg_6"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_7" pos="-0.1143 0.3 0.8261">
      <freejoint name="tray_swj_7"/>
      <geom name="tray_swg_7"
            type="mesh" mesh="switch_mesh"
            pos="-0.01475 0 0.00945"
            material="abs_dark"
            contype="0" conaffinity="0"/>
    </body>

    <body name="tray_sw_8" pos="-0.1333 0.3 0.8261">
      <freejoint name="tray_swj_8"/>
