        <geom name="s3_post_rr" type="box" size="0.030 0.030 0.519"
              pos="0.420 0.450 0.519" material="gantry_mat"/>
        <geom name="s3_beam_f"  type="box" size="0.420 0.025 0.025"
              pos="0 -0.110 1.039" material="gantry_beam"/>
        <geom name="s3_beam_r"  type="box" size="0.420 0.025 0.025"
              pos="0 0.450 1.039" material="gantry_beam"/>
        <geom name="s3_beam_l"  type="box" size="0.025 0.280 0.025"
              pos="-0.420 0.170 1.039" material="gantry_beam"/>
        <geom name="s3_beam_ri" type="box" size="0.025 0.280 0.025"
              pos="0.420 0.170 1.039" material="gantry_beam"/>
      </body>

      <!-- Rotating column + arms -->
      <body name="s3_column" pos="0 0.170 0.914">
        <geom name="s3_col_disc" type="cylinder" size="0.040 0.020"
              pos="0 0 0" material="column_mat"/>
        <geom name="s3_arm_1"   type="box" size="0.012 0.045 0.008"
              pos="0 -0.085 -0.005" material="arm_mat"/>
        <geom name="s3_head_1"  type="cylinder" size="0.010 0.025"
              pos="0 -0.130 -0.005" material="head_body"/>
        <geom name="s3_tip_1"   type="box" size="0.007 0.007 0.006"
              pos="0 -0.130 -0.036" material="head_tip"/>
        <geom name="s3_arm_2"   type="box" size="0.012 0.045 0.008"
              pos="0 0.085 -0.005" material="arm_mat"/>
        <geom name="s3_head_2"  type="cylinder" size="0.010 0.025"
              pos="0 0.130 -0.005" material="head_body"/>
        <geom name="s3_tip_2"   type="box" size="0.007 0.007 0.006"
              pos="0 0.130 -0.036" material="head_tip"/>
      </body>

      <!-- Tray feeder -->
      <body name="s3_feeder" pos="0 0.330 0">
        <geom name="s3_feed_leg_l" type="box" size="0.015 0.015 0.410"
              pos="-0.285 -0.030 0.410" material="steel_dark"
              contype="0" conaffinity="0"/>
        <geom name="s3_feed_leg_r" type="box" size="0.015 0.015 0.410"
