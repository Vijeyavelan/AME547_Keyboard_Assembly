      <body name="s3_case" pos="0 0.030 0.832">
        <geom name="s3_case_b"  type="box" size="0.1625 0.0575 0.001"
              pos="0 0 -0.011" material="abs_plastic"/>
        <geom name="s3_case_wl" type="box" size="0.001 0.0575 0.011"
