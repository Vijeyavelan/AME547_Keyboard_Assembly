      <!-- Gantry -->
      <body name="s3_gantry" pos="0 0 0">
        <geom name="s3_post_fl" type="box" size="0.030 0.030 0.519"
              pos="-0.420 -0.110 0.519" material="gantry_mat"/>
        <geom name="s3_post_fr" type="box" size="0.030 0.030 0.519"
