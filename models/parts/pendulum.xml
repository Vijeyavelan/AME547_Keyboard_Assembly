<mujoco model="pendulum">
  <option gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba=".8 .8 .8 1"/>

    <!-- Fixed pivot point -->
    <body name="pivot" pos="0 0 1.5">
      <geom type="sphere" size="0.02" rgba="0 0 0 1"/>

      <!-- Pendulum arm hanging from pivot -->
      <body name="arm" pos="0.3 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom type="capsule" fromto="0 0 0  0 0 -0.6" size="0.02" rgba="0.2 0.6 1 1"/>
        <!-- Bob at the end -->
        <body name="bob" pos="0 0 -0.6">
          <geom type="sphere" size="0.06" mass="1" rgba="1 0.3 0.3 1"/>
        </body>
      </body>
    </body>

  </worldbody>
  <keyframe>
    <key name="start" qpos="0.8"/>
  </keyframe>
</mujoco>