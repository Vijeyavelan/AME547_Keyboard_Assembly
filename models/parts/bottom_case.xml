<mujoco model="keyboard_bottom_case">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Component: Bottom Case (75% Layout, 84-key Keychron K2 V3)

    ── Resized to match verified aluminum plate STL (304.8mm × 114.3mm) ──

    Interior sizing:
      Plate    : 304.8mm (X) × 114.3mm (Y) × 1.5mm (Z)
      Clearance: 1mm each side
      Interior : 306.8mm (X) × 116.3mm (Y)
      Interior half-extents: X=0.1534, Y=0.05815

    Case outer dimensions:
      Wall thickness: 3mm
      Outer: 312.8mm (X) × 122.3mm (Y)
      Outer half-extents: X=0.1564, Y=0.06115
      Height: 22mm → body at z=0.011 above floor
              (6mm floor + 16mm usable interior depth)

    Coordinate convention:
      +X → keyboard length (left to right)
      +Y → keyboard width  (front to back, rear = +Y)
      +Z → up

    Body origin: geometric center of outer shell
      z_world = 0.011 when placed on floor (z=0)

    Interior reference planes (body-local):
      Floor top   z_local = -0.011 + 0.003 = -0.008m
      Rim top     z_local = +0.011m

    Assembly stack (no sound foam — dropped from BOM):
      Case floor top     z_world = 0.011 - 0.008 = 0.003m
      EPDM foam (1.5mm): 0.003 → 0.00450m
      Aluminum plate     : 0.00450 → 0.00600m
      Switches seat on plate top at z_world = 0.00600m

    Geometry strategy: 5 box geoms (1 floor + 4 walls)
    ABS plastic: density 1050 kg/m³, rgba charcoal

    Note: Battery rib tray positions are unchanged — battery footprint
    (90×60mm) and case-relative X offset (+25mm) are unchanged.
    Screw boss XY positions updated to new outer dimensions.
  -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <geom rgba="0.15 0.15 0.18 1"/>
  </default>

  <asset>
    <material name="abs_black"
              rgba="0.15 0.15 0.18 1"
              specular="0.3"
              shininess="0.4"
              reflectance="0.05"/>
  </asset>

  <worldbody>

    <geom name="ground" type="plane" size="1 1 0.1"
          pos="0 0 0" euler="0 0 0"
          friction="0.8 0.005 0.0001"
          rgba="0.4 0.4 0.4 1"/>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTTOM CASE BODY
         Outer: 312.8mm × 122.3mm × 22mm
         Body center at z=0.011 (half of 22mm height)
         ══════════════════════════════════════════════════════════════════ -->
    <body name="bottom_case" pos="0 0 0.011">

      <inertial pos="0 0 0"
                mass="0.085"
                diaginertia="3.2e-5 2.4e-4 2.5e-4"/>

      <!-- freejoint: comment out to make case a static fixture anchor -->
      <freejoint name="bottom_case_free"/>

      <!-- ── FLOOR SLAB ──────────────────────────────────────────────────
           Outer footprint: 312.8mm (X) × 122.3mm (Y) × 3mm thick
           Half-extents: 0.1564, 0.06115, 0.0015
           z_local center = -0.011 + 0.0015 = -0.0095
      -->
      <geom name="floor_slab"
            type="box"
            size="0.1564 0.06115 0.0015"
            pos="0 0 -0.0095"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── WALL: Left (−X side) — port cutout side ───────────────────
           Wall full height above floor: from floor top to rim top
             floor top z_local = -0.008m
             rim top   z_local = +0.011m
             wall height = 0.019m → half = 0.0095m
             wall center z_local = -0.008 + 0.0095 = +0.0015m
           Wall X position: outer face at X = -0.1564, center at -0.1564+0.0015 = -0.1549
           Wall Y span: full ±0.06115 (split around cutouts below)

           USB-C cutout: Y = +0.028 ± 0.0045, Z = 0.003 to 0.007 above floor top
           Power switch: Y = +0.0105 ± 0.007, Z = 0.004 to 0.008 above floor top  (toggle)
           OS switch   : Y = -0.0095 ± 0.007, Z = 0.004 to 0.008 above floor top  (toggle)

           Cutout Z (body-local):
             USB-C: Z = (-0.008+0.003) to (-0.008+0.007) = -0.005 to -0.001
                    center=-0.003, half=0.002
             Pwr/OS: Z = (-0.008+0.004) to (-0.008+0.008) = -0.004 to 0.000
                    center=-0.002, half=0.002 (slightly lower profile than USB)
      -->

      <!-- Segment A: rear section, before USB-C (+Y side) -->
      <!-- Y: +0.06115 down to USB-C rear edge +0.0325 → half=(0.06115-0.0325)/2=0.01433, center=0.06115-0.01433=0.04682 -->
      <geom name="wall_left_A"
            type="box"
            size="0.0015 0.01433 0.0095"
            pos="-0.1549 0.04682 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- USB-C fill BELOW cutout -->
      <geom name="wall_left_usbc_below"
            type="box"
            size="0.0015 0.0045 0.0045"
            pos="-0.1549 0.028 -0.0035"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- USB-C fill ABOVE cutout -->
      <geom name="wall_left_usbc_above"
            type="box"
            size="0.0015 0.0045 0.003"
            pos="-0.1549 0.028 0.008"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Segment B: between USB-C and power switch -->
      <!-- Y: USB-C front edge 0.0235 to power rear edge 0.0175 → half=0.003, center=0.020 -->
      <geom name="wall_left_B"
            type="box"
            size="0.0015 0.003 0.0095"
            pos="-0.1549 0.0205 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Power switch fill BELOW -->
      <geom name="wall_left_pwr_below"
            type="box"
            size="0.0015 0.007 0.004"
            pos="-0.1549 0.0105 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Power switch fill ABOVE -->
      <geom name="wall_left_pwr_above"
            type="box"
            size="0.0015 0.007 0.0025"
            pos="-0.1549 0.0105 0.0085"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Segment C: between power switch and OS switch -->
      <geom name="wall_left_C"
            type="box"
            size="0.0015 0.005 0.0095"
            pos="-0.1549 -0.0005 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- OS switch fill BELOW -->
      <geom name="wall_left_os_below"
            type="box"
            size="0.0015 0.007 0.004"
            pos="-0.1549 -0.0095 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- OS switch fill ABOVE -->
      <geom name="wall_left_os_above"
            type="box"
            size="0.0015 0.007 0.0025"
            pos="-0.1549 -0.0095 0.0085"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Segment D: front section, after OS switch (−Y side) -->
      <!-- Y: OS front edge -0.0165 down to -0.06115 → half=(0.06115-0.0165)/2=0.02233, center=-(0.0165+0.02233)=-0.03883 -->
      <geom name="wall_left_D"
            type="box"
            size="0.0015 0.02233 0.0095"
            pos="-0.1549 -0.03883 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ── CUTOUT INDICATOR SITES ─────────────────────────────────── -->
      <site name="usbc_cutout"
            type="box"
            size="0.001 0.0045 0.002"
            pos="-0.1565 0.028 0.003"
            rgba="0 0.5 1 0.9"/>

      <site name="power_cutout"
            type="box"
            size="0.001 0.007 0.002"
            pos="-0.1565 0.0105 0.003"
            rgba="0.2 0.9 0.2 0.9"/>

      <site name="os_cutout"
            type="box"
            size="0.001 0.007 0.002"
            pos="-0.1565 -0.0095 0.003"
            rgba="0.9 0.6 0.1 0.9"/>

      <!-- ── WALL: Right (+X side) — clean, no cutouts ─────────────── -->
      <geom name="wall_right"
            type="box"
            size="0.0015 0.06115 0.0095"
            pos="0.1549 0 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ── WALL: Rear (+Y side) ───────────────────────────────────── -->
      <geom name="wall_rear"
            type="box"
            size="0.1564 0.0015 0.0095"
            pos="0 0.05965 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ── WALL: Front (−Y side) ──────────────────────────────────── -->
      <geom name="wall_front"
            type="box"
            size="0.1564 0.0015 0.0095"
            pos="0 -0.05965 0.0015"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ══════════════════════════════════════════════════════════════
           BATTERY RIB TRAY
           Battery: 90mm (X) × 60mm (Y) × 6mm (Z), center at X=+25mm
           Rib bottom: sits on floor top face (z_local = -0.008m)
           Rib height: 4mm → rib center z_local = -0.006m
           Rib thickness: 1.5mm
           ══════════════════════════════════════════════════════════════ -->

      <!-- Battery rib: Left side (−Y) -->
      <geom name="battery_rib_left"
            type="box"
            size="0.045 0.00075 0.002"
            pos="0.025 -0.03075 -0.006"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Battery rib: Right side (+Y) -->
      <geom name="battery_rib_right"
            type="box"
            size="0.045 0.00075 0.002"
            pos="0.025 0.03075 -0.006"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Battery rib: Front (−X), split for JST connector clearance -->
      <geom name="battery_rib_front_left"
            type="box"
            size="0.00075 0.0125 0.002"
            pos="-0.02025 -0.0175 -0.006"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <geom name="battery_rib_front_right"
            type="box"
            size="0.00075 0.0125 0.002"
            pos="-0.02025 0.0175 -0.006"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Battery rib: Rear (+X) -->
      <geom name="battery_rib_rear"
            type="box"
            size="0.00075 0.030 0.002"
            pos="0.07025 0 -0.006"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ══════════════════════════════════════════════════════════════
           SCREW BOSSES (M3 plate-to-case screws)
           Updated XY positions for new outer dimensions:
             X: ±(0.1564 - 0.008) = ±0.1484m  (8mm inset from outer wall)
             Y: ±(0.06115 - 0.008) = ±0.05315m
           Boss: radius 3mm, height 8mm rising from floor top
             floor top z_local = -0.008m
             boss center z = -0.008 + 0.004 = -0.004m
           ══════════════════════════════════════════════════════════════ -->

      <!-- Screw boss: Front-Left (−X, −Y corner) -->
      <geom name="screw_boss_geom_FL"
            type="cylinder"
            size="0.003 0.004"
            pos="-0.1484 -0.05315 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Screw boss: Front-Right (+X, −Y corner) -->
      <geom name="screw_boss_geom_FR"
            type="cylinder"
            size="0.003 0.004"
            pos="0.1484 -0.05315 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Screw boss: Rear-Left (−X, +Y corner) -->
      <geom name="screw_boss_geom_RL"
            type="cylinder"
            size="0.003 0.004"
            pos="-0.1484 0.05315 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- Screw boss: Rear-Right (+X, +Y corner) -->
      <geom name="screw_boss_geom_RR"
            type="cylinder"
            size="0.003 0.004"
            pos="0.1484 0.05315 -0.004"
            material="abs_black"
            density="1050"
            friction="1.0 0.005 0.0001"
            condim="4" priority="1"/>

      <!-- ══════════════════════════════════════════════════════════════
           REGISTRATION SITES
           All in body-local frame (z=0 at body center)
           ══════════════════════════════════════════════════════════════ -->

      <!-- Center of case floor (fixture dowel registration) -->
      <site name="fixture_dowel_center"
            type="cylinder"
            size="0.002 0.001"
            pos="0 0 -0.0095"
            rgba="1 0.8 0 1"/>

      <!-- Corner screw boss sites -->
      <site name="screw_boss_FL"
            type="cylinder" size="0.003 0.001"
            pos="-0.1484 -0.05315 -0.0085"
            rgba="0.8 0.2 0.2 1"/>
      <site name="screw_boss_FR"
            type="cylinder" size="0.003 0.001"
            pos="0.1484 -0.05315 -0.0085"
            rgba="0.8 0.2 0.2 1"/>
      <site name="screw_boss_RL"
            type="cylinder" size="0.003 0.001"
            pos="-0.1484 0.05315 -0.0085"
            rgba="0.8 0.2 0.2 1"/>
      <site name="screw_boss_RR"
            type="cylinder" size="0.003 0.001"
            pos="0.1484 0.05315 -0.0085"
            rgba="0.8 0.2 0.2 1"/>

      <!-- PCB placement origin -->
      <site name="pcb_origin"
            type="box" size="0.001 0.001 0.0002"
            pos="0 0 -0.006"
            rgba="0.2 0.8 0.2 0.0"/>

      <!-- Interior floor surface reference (plate/foam rest here) -->
      <site name="floor_surface"
            type="box" size="0.1534 0.05815 0.0002"
            pos="0 0 -0.008"
            rgba="0.9 0.5 0.1 0.0"/>

      <!-- Rim top face reference (where case mates with top case) -->
      <site name="rim_top"
            type="box" size="0.1564 0.06115 0.0002"
            pos="0 0 0.011"
            rgba="0.9 0.5 0.1 0.0"/>

      <!-- Robot end-effector grasp targets -->
      <site name="grasp_top_center"
            type="sphere" size="0.002"
            pos="0 0 0.011"
            rgba="0 0.6 0.8 0.4"/>

      <site name="vacuum_grasp_left"
            type="sphere" size="0.002"
            pos="-0.08 0 0.011"
            rgba="0 0.6 0.8 0.3"/>

      <site name="vacuum_grasp_right"
            type="sphere" size="0.002"
            pos="0.08 0 0.011"
            rgba="0 0.6 0.8 0.3"/>

    </body>

  </worldbody>

</mujoco>