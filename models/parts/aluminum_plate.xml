  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <material name="aluminum_silver"
              rgba="0.75 0.75 0.78 1"
              specular="0.8"
              shininess="0.7"
              reflectance="0.3"/>

    <material name="plate_col"
              rgba="0.75 0.75 0.78 0.0"/>
  </asset>

