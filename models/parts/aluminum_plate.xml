  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <mesh name="aluminum_plate_mesh"
          file="Aluminum_Plate.stl"
          scale="0.001 0.001 0.001"/>

    <material name="aluminum_silver"
