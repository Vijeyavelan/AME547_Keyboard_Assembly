<mujoco model="robot_arm">
  <option gravity="0 0 -9.81" timestep = "0.01"/>

  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba=".8 .8 .8 1"/>

    <!-- Fixed base -->
    <body name="base" pos="0 0 0.5">
      <geom type="cylinder" size="0.05 0.05" rgba="0.4 0.4 0.4 1"/>

      <!-- First link -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" damping="1"/>
        <geom type="capsule" fromto="0 0 0  0.4 0 0" size="0.03" rgba="0.2 0.6 1 1"/>

        <!-- Second link -->
        <body name="link2" pos="0.4 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" damping="1"/>
          <geom type="capsule" fromto="0 0 0  0.3 0 0" size="0.025" rgba="1 0.5 0.2 1"/>

          <!-- End effector tip -->
          <body name="tip" pos="0.3 0 0">
            <geom type="sphere" size="0.03" rgba="1 1 0 1"/>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <!-- Actuators control the joints -->
  <actuator>
    <position name="act1" joint="joint1" kp="10"/>
    <position name="act2" joint="joint2" kp="10"/>
  </actuator>


</mujoco>