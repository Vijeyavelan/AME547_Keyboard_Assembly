<mujoco model="pick_and_place">
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba=".8 .8 .8 1"/>

    <!-- Fixed base -->
    <body name="base" pos="0 0 0.3">
      <geom type="cylinder" size="0.05 0.1" rgba="0.4 0.4 0.4 1"/>

      <!-- Shoulder - rotates horizontally -->
      <body name="shoulder" pos="0 0 0.1">
        <joint name="joint_shoulder" type="hinge" axis="0 0 1" damping="20"/>
        <geom type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.3 1"/>

        <!-- Upper arm - tilts vertically -->
        <body name="upper_arm" pos="0 0 0.02">
          <joint name="joint_upper" type="hinge" axis="0 1 0" damping="5"/>
          <geom type="capsule" fromto="0 0 0  0.4 0 0" size="0.03" rgba="0.2 0.6 1 1"/>

          <!-- Forearm - bends at elbow -->
          <body name="forearm" pos="0.4 0 0">
            <joint name="joint_elbow" type="hinge" axis="0 1 0" damping="5"/>
            <geom type="capsule" fromto="0 0 0  0.35 0 0" size="0.025" rgba="1 0.5 0.2 1"/>

            <!-- Tip -->
            <body name="tip" pos="0.35 0 0">
              <geom type="sphere" size="0.03" rgba="1 1 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Object to pick -->
    <body name="object" pos="0.5 0 0.05">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.05" rgba="1 0 0 1" mass="0.1"/>
    </body>

    <!-- Target -->
    <body name="target" pos="-0.5 0 0.01">
      <geom type="box" size="0.06 0.06 0.01" rgba="0 1 0 0.3"/>
    </body>

  </worldbody>

  <actuator>
    <position name="act_shoulder" joint="joint_shoulder" kp="100"/>
    <position name="act_upper"    joint="joint_upper"    kp="100"/>
    <position name="act_elbow"    joint="joint_elbow"    kp="100"/>
  </actuator>

</mujoco>