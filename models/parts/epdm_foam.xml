<mujoco model="keyboard_epdm_foam">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Component: EPDM Foam Layer

    Reference: Keychron K2 V3 tray-mount design

    ── Resized to match updated bottom_case.xml interior ──

    Interior dimensions (from updated bottom_case.xml):
      X: 306.8mm → half = 0.1534m
      Y: 116.3mm → half = 0.05815m
      (Derived from plate 304.8×114.3mm + 1mm clearance each side)

    Foam thickness: 1.5mm (unchanged)

    Coordinate convention: matches bottom_case.xml exactly
      Body origin = geometric center of foam sheet
      Foam bottom face sits on case floor top face:
        case floor top z_world = 0.003m
        foam center z_world    = 0.003 + 0.00075 = 0.00375m

    Assembly stack (no sound foam — dropped from BOM):
      Case floor top     z_world = 0.003m
      EPDM foam (1.5mm): 0.003 → 0.00450m
      Aluminum plate     : 0.00450 → 0.00600m

    Battery cutout: UNCHANGED (battery footprint unchanged)
      Battery center X = +25mm from case center
      Cutout X: -0.020m to +0.070m
      Cutout Y: -0.030m to +0.030m

    5-geom layout (top view, X horizontal, Y vertical):
      ┌─────────────────────────────────────────────────────────┐
      │  [LEFT SLAB]     [   BATTERY   ]     [RIGHT SLAB]      │
      │                  [   CUTOUT    ]                        │
      │  ────────────    ─────────────  ──────────────────────  │
      │  [          FRONT STRIP (full X, trimmed corners)    ]  │
      │  ──────────────────────────────────────────────────     │
      │  [          REAR  STRIP (full X, trimmed corners)    ]  │
      └─────────────────────────────────────────────────────────┘

    Geom calculations:
      FRONT STRIP (Y from -0.05815 to -0.030):
        half-Y  = (0.05815 - 0.030) / 2 = 0.01408
        center-Y = -(0.030 + 0.01408)   = -0.04408
        half-X (trimmed 8mm for corner screw bosses) = 0.1534 - 0.008 = 0.1454

      REAR STRIP (Y from +0.030 to +0.05815):
        half-Y  = 0.01408 (symmetric)
        center-Y = +0.04408
        half-X = 0.1454 (same trim)

      LEFT SLAB (X from -0.1534 to -0.020, Y ±0.030):
        half-X  = (0.1534 - 0.020) / 2 = 0.06670
        center-X = -0.1534 + 0.06670 = -0.08670
        half-Y = 0.030, center-Y = 0

      RIGHT SLAB (X from +0.070 to +0.1534, Y ±0.030):
        half-X  = (0.1534 - 0.070) / 2 = 0.04170
        center-X = 0.070 + 0.04170 = 0.11170
        half-Y = 0.030, center-Y = 0

    Material: EPDM rubber foam
      density  : 200 kg/m³
      rgba     : very dark grey
  -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <material name="epdm_foam"
              rgba="0.18 0.18 0.20 1"
              specular="0.05"
              shininess="0.1"
              reflectance="0.02"/>
  </asset>

  <worldbody>

    <geom name="ground" type="plane" size="1 1 0.1"
          pos="0 0 0"
          friction="0.8 0.005 0.0001"
          rgba="0.4 0.4 0.4 1"/>

    <!-- ══════════════════════════════════════════════════════════════════
         EPDM FOAM BODY
         Sits on case floor top face:
           case floor top z_world = 0.003m
           foam center z_world    = 0.003 + 0.00075 = 0.00375m
         ══════════════════════════════════════════════════════════════════ -->
    <body name="epdm_foam" pos="0 0 0.00375">

      <inertial pos="0 0 0"
                mass="0.008"
                diaginertia="1.2e-5 3.8e-5 5.0e-5"/>

      <freejoint name="epdm_foam_free"/>

      <!-- ── FRONT STRIP ──────────────────────────────────────────────
           Y range: -0.05815 to -0.030
           half-Y  = 0.01408, center-Y = -0.04408
           Trimmed X for screw boss clearance: half-X = 0.1454, center-X = 0
      -->
      <geom name="foam_front_strip"
            type="box"
            size="0.1454 0.01408 0.00075"
            pos="0 -0.04408 0"
            material="epdm_foam"
            density="200"
            friction="0.8 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── REAR STRIP ───────────────────────────────────────────────
           Y range: +0.030 to +0.05815
           Symmetric to front strip
      -->
      <geom name="foam_rear_strip"
            type="box"
            size="0.1454 0.01408 0.00075"
            pos="0 0.04408 0"
            material="epdm_foam"
            density="200"
            friction="0.8 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── LEFT SLAB ────────────────────────────────────────────────
           X range: -0.1534 to -0.020 (left of battery cutout)
           half-X = 0.06670, center-X = -0.08670
           Y range: ±0.030 (battery-cutout height band)
      -->
      <geom name="foam_left_slab"
            type="box"
            size="0.06670 0.030 0.00075"
            pos="-0.08670 0 0"
            material="epdm_foam"
            density="200"
            friction="0.8 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── RIGHT SLAB ───────────────────────────────────────────────
           X range: +0.070 to +0.1534 (right of battery cutout)
           half-X = 0.04170, center-X = +0.11170
           Y range: ±0.030
      -->
      <geom name="foam_right_slab"
            type="box"
            size="0.04170 0.030 0.00075"
            pos="0.11170 0 0"
            material="epdm_foam"
            density="200"
            friction="0.8 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ══════════════════════════════════════════════════════════════
           REGISTRATION SITES
           ══════════════════════════════════════════════════════════════ -->

      <!-- Foam center ref — on solid foam left of battery cutout -->
      <site name="foam_center"
            type="sphere" size="0.002"
            pos="-0.06 0 0.00075"
            rgba="0 0.6 0.8 0.4"/>

      <!-- Battery cutout corners -->
      <site name="battery_cutout_FL"
            type="sphere" size="0.0015"
            pos="-0.020 -0.030 0.00075"
            rgba="1 0.6 0 0.5"/>
      <site name="battery_cutout_FR"
            type="sphere" size="0.0015"
            pos="0.070 -0.030 0.00075"
            rgba="1 0.6 0 0.5"/>
      <site name="battery_cutout_RL"
            type="sphere" size="0.0015"
            pos="-0.020 0.030 0.00075"
            rgba="1 0.6 0 0.5"/>
      <site name="battery_cutout_RR"
            type="sphere" size="0.0015"
            pos="0.070 0.030 0.00075"
            rgba="1 0.6 0 0.5"/>

      <!-- Vacuum grasp points — both on LEFT solid slab -->
      <site name="vacuum_grasp_left"
            type="sphere" size="0.002"
            pos="-0.12 0 0.00075"
            rgba="0 0.6 0.8 0.3"/>
      <site name="vacuum_grasp_right"
            type="sphere" size="0.002"
            pos="-0.05 0 0.00075"
            rgba="0 0.6 0.8 0.3"/>

    </body>

  </worldbody>

</mujoco>