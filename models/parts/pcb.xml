<mujoco model="keyboard_pcb">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Component: PCB (Printed Circuit Board)

    Reference: Keychron K2 V3

    ── Resized to match updated bottom_case.xml (new plate 304.8×114.3mm) ──

    Dimensions:
      302mm × 112mm × 1.6mm (standard FR4)
      Half-extents: 0.1510, 0.0560, 0.0008

    Case interior (updated): 306.8mm × 116.3mm
      PCB clearance from case interior walls:
        X: (306.8 - 302.0) / 2 = 2.4mm each side ✓
        Y: (116.3 - 112.0) / 2 = 2.15mm each side ✓
      Left edge (USB-C face) at X = -0.1510
      Connector housings protrude ~1.5mm beyond left edge at X ≈ -0.1525

    Screw hole alignment (matches updated bottom_case.xml screw bosses):
      Corner bosses: X = ±0.1484, Y = ±0.05315
        PCB half-X = 0.1510 → bosses 2.6mm inside PCB edge in X ✓
        PCB half-Y = 0.0560 → bosses 2.85mm inside PCB edge in Y ✓

    Coordinate convention: matches bottom_case.xml
      +X → keyboard length
      +Y → keyboard width (front to back)
      +Z → up

    Position in assembly stack:
      PCB sits on top of battery (tilt-and-insert approach)
      Battery top z_world  = 0.01050m  (unchanged)
      PCB bottom z_world   = 0.01050m
      PCB center z_world   = 0.01050 + 0.0008 = 0.01130m
      PCB body pos z       = 0.01130m

    Note: Sound foam removed from BOM. Assembly stack under PCB is:
      Case floor top → EPDM foam (1.5mm) → Battery (6mm) → PCB
      The aluminum plate sits separately on the EPDM foam beside the battery.

    Left edge features (−X face):
      USB-C port housing : Y = +0.028
      Power switch body  : Y = +0.0105
      OS switch body     : Y = -0.0095
      All protrude from PCB left edge (X = -0.1510) into wall cutout

    Switch socket sites:
      84 hot-swap socket positions matching aluminum_plate site grid exactly
      Site Z = PCB top face = +0.0008m (body local)
      Named sock_<key>
      All sites verified within new PCB boundary:
        X range: ±0.1429 vs half 0.1510 ✓
        Y range: ±0.0480 vs half 0.0560 ✓

    Screw hole sites:
      4 corners (FL, FR, RL, RR) — aligned to case screw boss XY
      4 center screws (C1–C4) — within PCB footprint

    Material: FR4 glass-epoxy
      rgba    : dark green PCB color
      density : 1850 kg/m³
      Mass    : 302×112×1.6mm × 1.85g/cm³ ≈ 100g

    Gripper approach (unchanged):
      Angled insertion — left edge enters case first (10° tilt)
      USB-C/switch features engage wall cutouts
      PCB lowers flat onto battery top
      Vacuum dual pad on top face, right side
  -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <material name="fr4_green"
              rgba="0.08 0.35 0.08 1"
              specular="0.2"
              shininess="0.3"
              reflectance="0.05"/>

    <material name="connector_dark"
              rgba="0.15 0.15 0.15 1"
              specular="0.4"
              shininess="0.5"/>
  </asset>

  <worldbody>

    <geom name="ground" type="plane" size="1 1 0.1"
          pos="0 0 0"
          friction="0.8 0.005 0.0001"
          rgba="0.4 0.4 0.4 1"/>

    <!-- ══════════════════════════════════════════════════════════════════
         PCB BODY
         Body pos z = 0.01130m (PCB center above ground)
         In standalone validation: pos="0 0 0.01130" places PCB at
         correct world height above a floor at z=0.
         ══════════════════════════════════════════════════════════════════ -->
    <body name="pcb" pos="0 0 0.01130">

      <inertial pos="0 0 0"
                mass="0.100"
                diaginertia="9.3e-5 8.1e-4 8.9e-4"/>

      <freejoint name="pcb_free"/>

      <!-- ── MAIN PCB BOARD ─────────────────────────────────────────────
           302mm × 112mm × 1.6mm
           Half-extents: 0.1510, 0.0560, 0.0008
      -->
      <geom name="pcb_board"
            type="box"
            size="0.1510 0.0560 0.0008"
            pos="0 0 0"
            material="fr4_green"
            density="1850"
            friction="0.6 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── LEFT EDGE FEATURES (−X face) ──────────────────────────────
           Connectors protrude from PCB left edge at X = -0.1510
           Protrusion depth: 1.5mm → geom center X = -(0.1510 + 0.0015) = -0.1525
           Y and Z positions unchanged from original.
      -->

