<mujoco model="keyboard_pcb">
  <!--
    AME 547 - Keyboard Assembly Cell Simulation
    Component: PCB (Printed Circuit Board)

    Reference: Keychron K2 V3

    Dimensions:
      313mm × 107mm × 1.6mm (standard FR4)
      Wider than original 305mm to incorporate FR/RR screw boss positions
      Half-extents: 0.1565, 0.0535, 0.0008

      Case interior: 319×109mm (half: 0.1595, 0.0545)
      PCB clearance from case walls: 3mm each side ✓
      Left connector face at X=-0.1540, PCB left edge at X=-0.1565
        → 2.5mm connector clearance from PCB edge ✓
      FR/RR boss at X=+0.1545, PCB right edge at X=+0.1565
        → 2mm boss clearance from PCB edge ✓

    Coordinate convention: matches bottom_case.xml
      +X → keyboard length
      +Y → keyboard width (front to back)
      +Z → up

    Position in assembly stack:
      Sits on top of battery
      Battery top z_world  = 0.01050m
      PCB bottom z_world   = 0.01050m
      PCB center z_world   = 0.01050 + 0.0008 = 0.01130m
      PCB body pos z       = 0.01130m

    Left edge features (-X face):
      USB-C port housing : Y=+0.028
      Power switch body  : Y=+0.0105
      OS switch body     : Y=-0.0095

    Switch socket sites:
      84 hot-swap socket positions matching aluminum_plate grid
      Site Z = PCB top face = +0.0008m (body local)
      Named sock_<key>

    Screw hole sites:
      All 8 screw positions now on PCB:
      FL, FR corners + 4 center (RL, RR also included)
      Site Z = PCB top face = +0.0008m

    Material: FR4 glass-epoxy
      rgba    : dark green PCB color
      density : 1850 kg/m³
      Mass    : 313×107×1.6mm × 1.85g/cm³ ≈ 99g

    Gripper approach:
      Angled insertion — left edge enters case first
      USB-C/switch features engage wall cutouts
      Then PCB lowers flat onto battery
      Vacuum dual pad on top face, right side
  -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <material name="fr4_green"
              rgba="0.08 0.35 0.08 1"
              specular="0.2"
              shininess="0.3"
              reflectance="0.05"/>

    <material name="connector_dark"
              rgba="0.15 0.15 0.15 1"
              specular="0.4"
              shininess="0.5"/>
  </asset>

  <worldbody>

    <geom name="ground" type="plane" size="1 1 0.1"
          pos="0 0 0"
          friction="0.8 0.005 0.0001"
          rgba="0.4 0.4 0.4 1"/>

    <body name="pcb" pos="0 0 0.0008">

      <inertial pos="0 0 0"
                mass="0.099"
                diaginertia="9.3e-5 8.1e-4 8.9e-4"/>

      <freejoint name="pcb_free"/>

      <!-- ── MAIN PCB BOARD ─────────────────────────────────────────────
           313mm × 107mm × 1.6mm
           Half-extents: 0.1565, 0.0535, 0.0008
      -->
      <geom name="pcb_board"
            type="box"
            size="0.1565 0.0535 0.0008"
            pos="0 0 0"
            material="fr4_green"
            density="1850"
            friction="0.6 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ── LEFT EDGE FEATURES (-X face) ──────────────────────────────
           Connectors at physical positions — unchanged from original
           All protrude from PCB left edge at X=-0.154
      -->
      <geom name="usbc_housing"
            type="box"
            size="0.0015 0.0045 0.002"
            pos="-0.154 0.028 0.001"
            material="connector_dark"
            density="1050"
            friction="0.6 0.005 0.0001"
            condim="4"
            priority="1"/>

      <geom name="power_switch"
            type="box"
            size="0.0015 0.007 0.003"
            pos="-0.154 0.0105 0.002"
            material="connector_dark"
            density="1050"
            friction="0.6 0.005 0.0001"
            condim="4"
            priority="1"/>

      <geom name="os_switch"
            type="box"
            size="0.0015 0.007 0.003"
            pos="-0.154 -0.0095 0.002"
            material="connector_dark"
            density="1050"
            friction="0.6 0.005 0.0001"
            condim="4"
            priority="1"/>

      <!-- ══════════════════════════════════════════════════════════════
           REFERENCE SITES
           ══════════════════════════════════════════════════════════════ -->

      <!-- PCB center reference -->
      <site name="pcb_center"
            type="sphere" size="0.002"
            pos="0 0 0.0008"
            rgba="0 0.8 0.2 0.4"/>

      <!-- Left edge insertion reference — robot aligns to usbc_cutout -->
      <site name="left_edge_ref"
            type="sphere" size="0.002"
            pos="-0.1565 0.028 0"
            rgba="0 0.5 1 0.8"/>

      <!-- Vacuum grasp sites — right side, away from left edge features -->
      <site name="vacuum_grasp_left"
            type="sphere" size="0.002"
            pos="0.05 0 0.0008"
            rgba="0 0.6 0.8 0.3"/>

      <site name="vacuum_grasp_right"
            type="sphere" size="0.002"
            pos="0.12 0 0.0008"
            rgba="0 0.6 0.8 0.3"/>

      <!-- ══════════════════════════════════════════════════════════════
           SWITCH SOCKET SITES — 84 hot-swap socket positions
           Matches aluminum_plate switch site grid exactly
           Site Z = PCB top face = +0.0008m (body local)
           ══════════════════════════════════════════════════════════════ -->

